rules_version = '2';
// Firestore security rules for Support-to-Docs Pipeline.
//
// Trust model:
//   - All draft writes are performed by the backend (firebase-admin SDK) which
//     bypasses rules entirely. Client browsers MUST NOT write to this collection.
//   - Authenticated users may read draft documents to power the real-time
//     collaborative-edit indicator (useFirestoreDraft hook).
//   - No other collections are exposed to the client SDK.
//
// IMPORTANT: Deploy these rules with `firebase deploy --only firestore:rules`
// before any production release. Without deployed rules the project runs in
// test mode (open read/write) which is a Critical security defect.

service cloud.firestore {
  match /databases/{database}/documents {

    // drafts/{draftId} — read-only for authenticated users; writes are
    // exclusively via the firebase-admin SDK (server-side, bypasses rules).
    match /drafts/{draftId} {
      allow read: if request.auth != null;
      allow write: if false;  // server-only; firebase-admin bypasses this rule
    }

    // Deny all other collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
