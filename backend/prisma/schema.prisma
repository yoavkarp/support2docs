generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum TicketStatus {
  PENDING
  VECTORIZED
  CLUSTERED
}

enum ClusterStatus {
  FORMING
  READY
}

enum DraftStatus {
  PENDING_REVIEW
  APPROVED
  DISCARDED
}

enum DraftEventAction {
  CREATED
  APPROVED
  DISCARDED
  EDITED
}

enum MemberRole {
  ADMIN
  MEMBER
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  firebaseUid String  @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id           String       @id @default(uuid()) @db.Uuid
  sourceId     String       @unique
  source       String
  subject      String
  transcript   String       @db.Text
  embedding    Unsupported("vector(1536)")?
  status       TicketStatus @default(PENDING)
  clusterId    String?      @db.Uuid
  cluster      Cluster?     @relation(fields: [clusterId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Cluster {
  id        String        @id @default(uuid()) @db.Uuid
  centroid  Unsupported("vector(1536)")?
  status    ClusterStatus @default(FORMING)
  tickets   Ticket[]
  drafts    Draft[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Draft {
  id           String        @id @default(uuid()) @db.Uuid
  title        String
  content      String        @db.Text
  status       DraftStatus   @default(PENDING_REVIEW)
  clusterId    String        @db.Uuid
  cluster      Cluster       @relation(fields: [clusterId], references: [id])
  publishedUrl String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  events       DraftEvent[]
  orgId        String?       @db.Uuid
  org          Organization? @relation(fields: [orgId], references: [id])
}

model DraftEvent {
  id        String   @id @default(uuid()) @db.Uuid
  draftId   String   @db.Uuid
  draft     Draft    @relation(fields: [draftId], references: [id])
  action    DraftEventAction
  userId    String
  userEmail String
  timestamp DateTime @default(now())
  orgId     String?  @db.Uuid
}

model Organization {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  slug       String   @unique
  logoUrl    String?
  createdAt  DateTime @default(now())

  members  OrganizationMember[]
  settings OrganizationSettings?
  drafts   Draft[]
}

model OrganizationMember {
  id        String     @id @default(uuid()) @db.Uuid
  orgId     String     @db.Uuid
  org       Organization @relation(fields: [orgId], references: [id])
  userId    String?
  userEmail String
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now())

  @@unique([orgId, userEmail])
}

model OrganizationSettings {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @unique @db.Uuid
  org              Organization @relation(fields: [orgId], references: [id])
  zendeskSubdomain String?
  zendeskApiKey    String?
  intercomToken    String?
  kbPublishUrl     String?
  clusterThreshold Float        @default(0.65)
  minClusterSize   Int          @default(5)
  updatedAt        DateTime     @updatedAt
}
